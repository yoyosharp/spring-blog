spring:
  application:
    name: spring-blog
  datasource:
    url: jdbc:postgresql://localhost:5432/starter
    username: 
    password: 
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: 10
      connection-timeout: 60000
  jpa:
    show-sql: true
  data:
    redis:
      host: localhost
      port: 6379
      password: 
  cache:
    type: redis
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
    baseline-version: 0
    clean-disabled: true
    validate-on-migrate: true
    schemas: public
  security:
    user:
      name: 
      password: 
    oauth2:
      client:
        registration:
          google:
            client-id: 
            client-secret: 
            scope: email,profile
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
          github:
            client-id: 
            client-secret: 
            scope: user:email,read:user
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
        provider:
          github:
            authorization-uri: https://github.com/login/oauth/authorize
            token-uri: https://github.com/login/access_token
            user-info-uri: https://api.github.com/user
  mail:
    host: smtp.gmail.com
    port: 587
    username: 
    password: 
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
  messages:
    basename: i18n/messages
    encoding: UTF-8
    cache-duration: 3600
    fallback-to-system-locale: false
  rabbitmq:
    host: localhost
    port: 5672
    username: 
    password: 
    virtual-host: /

server:
  port: 8088

# JWT / AES / hashing keys. jwt.aes.* and app.hashing.* are carried over from
# application.properties.example; no code in the tree reads them today.
jwt:
  aes:
    key: 
    iv: 
  rsa:
    path:
      private-key: 
      public-key: 
  expiration-time-in-seconds: 3600
  clock-skew-in-seconds: 300
  refresh-token:
    expiration-time-in-days: 30

app:
  hashing:
    key: 
    iv: 

# Not read by any code in the tree today; carried over from the .properties example.
application:
  defaultMailClient: GmailByJavaMailer
  google:
    credentials:
      json: 

aws:
  s3:
    bucket-name: 
    access-key: 
    secret-key: 

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui

logging:
  level:
    org:
      springframework:
        aop: DEBUG
        security: info
